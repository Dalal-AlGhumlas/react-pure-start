# All URLs and keys must belong to the SAME Supabase project.
# Never commit real values. Configure hosting environment variables and rebuild.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# SERVER ONLY: service_role JWT or sb_secret_ key. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
# Optional override for the owner-confirmed public club email.
VITE_CONTACT_EMAIL=Development.lawclub@gmail.com
